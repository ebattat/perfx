# ── Model selection ────────────────────────────────────────────────────────
# Choose backend: gemini or claude (default)
PERFBOT_MODEL=

# ── Gemini (used when PERFBOT_MODEL=gemini) ────────────────────────────────
GEMINI_API_KEY=

# ── Claude via Vertex AI (used when PERFBOT_MODEL=claude) ──────────────────
CLAUDE_CODE_USE_VERTEX=
CLOUD_ML_REGION=
ANTHROPIC_VERTEX_PROJECT_ID=

# Claude via Anthropic API (alternative to Vertex — set one or the other)
# ANTHROPIC_API_KEY=

# ── GitHub ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GIT_REPOS=

# ── Jira ───────────────────────────────────────────────────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Debug ──────────────────────────────────────────────────────────────────
# PERFBOT_DEBUG=1
# PERFX_LOG_LEVEL=debug

# ── Model selection ────────────────────────────────────────────────────────
# Choose backend: gemini (default) or claude
PERFBOT_MODEL=gemini

# ── Gemini (used when PERFBOT_MODEL=gemini) ────────────────────────────────
GEMINI_API_KEY=

# ── Claude via Vertex AI (used when PERFBOT_MODEL=claude) ──────────────────
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=global
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id

# Claude via Anthropic API (alternative to Vertex — set one or the other)
# ANTHROPIC_API_KEY=

# ── GitHub ─────────────────────────────────────────────────────────────────
# Optional — without it you get 60 req/hour (anonymous). Set for 5000 req/hour.
GITHUB_TOKEN=

# Comma-separated list of allowed repos (full URLs)
GIT_REPOS=['https://github.com/your-org/your-repo']

# ── Jira ───────────────────────────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ── Debug ──────────────────────────────────────────────────────────────────
# Set to 1 to enable debug logging (tool args, results, tracebacks)
# PERFBOT_DEBUG=1
# PERFBOT_LOG_LEVEL=debug
